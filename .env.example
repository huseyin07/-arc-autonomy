# PUBLIC: RPC endpoints and WalletConnect project IDs are browser-readable.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# SERVER ONLY: never add NEXT_PUBLIC_ to these variables or expose them to clients.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_AGENT_WALLET_SET_ID=
DATABASE_URL=postgresql://user:password@localhost:5432/arc_autonomy
AUTH_SESSION_SECRET=
# Trusted authentication message domain, e.g. app.arcautonomy.xyz (required in production unless Vercel provides VERCEL_PROJECT_PRODUCTION_URL).
AUTH_APP_DOMAIN=localhost:3000

# Optional; scripts refuse to provision unless explicitly enabled.
ENABLE_CIRCLE_INTEGRATION_TESTS=false
